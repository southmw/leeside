{
  "name": "leeside",
  "private": true,
  "version": "0.1.0",
  "description": "LEESIDE - a third-person survival action RPG for desktop browsers",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:deployed": "node scripts/smoke-deployed.mjs",
    "size": "node scripts/size.mjs",
    "loadtime": "node scripts/loadtime.mjs",
    "perf:report": "node scripts/perf-report.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run size && npm run smoke:deployed && npm run smoke",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "miniplex": "^2.0.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  }
}
